# InfluMatch.jo — .gitignore

# Environment
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual Environment
venv/
.venv/
env/
ENV/

# Database
*.db
*.sqlite
*.sqlite3

# ChromaDB persistent data
data/chroma_db/

# Logs
logs/*.log
logs/*.json
*.log

# Claude Code (local AI assistant workspace)
.claude/

# Windows crash dumps
*.stackdump

# Next.js build cache
frontend_next/tsconfig.tsbuildinfo
frontend_next/test-results/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Streamlit
.streamlit/secrets.toml

# Migrations (keep structure, ignore auto-generated)
migrations/versions/*.pyc

# ============================================================
# InfluMatch.jo — Environment Variables Template
# Copy to .env and fill in real values
# ============================================================

# --- Application ---
APP_NAME=InfluMatch.jo
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-strong-random-secret-key-min-32-chars
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./influmatch.db
# Production: DATABASE_URL=postgresql+asyncpg://user:pass@localhost/influmatch

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Claude AI (Primary LLM) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_MAX_TOKENS=4096

# --- OpenAI (Fallback LLM) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_INFLUENCERS=influencers
CHROMA_COLLECTION_CAMPAIGNS=campaigns

# --- Stripe (Test Mode — JOD Simulation) ---
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# --- Finance / Jordan Market ---
DEFAULT_CURRENCY=JOD
VAT_RATE=0.16
ESCROW_FEE_PERCENT=0.05
MIN_CAMPAIGN_BUDGET_JOD=50.0
PLATFORM_WALLET_ID=platform_wallet_001

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_FILE=./logs/influmatch.log

# --- Streamlit Frontend ---
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000
